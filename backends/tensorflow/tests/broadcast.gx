package gxtftests

import "shape"

// BroadcastFloat32 broadcasts x from [1][3] to [3][3].
func BroadcastFloat32(x [1][3]float32) [3][3]float32 {
	return shape.Broadcast[[]int{3, 3}](x)
}

// BroadcastInt32 broadcasts x from [1][3] to [3][3].
func BroadcastInt32(x [1][3]int32) [3][3]int32 {
	return shape.Broadcast[[]int{3, 3}](x)
}

// BroadcastInnerAxisInt32 broadcasts x from [2][1][3] to [2][5][3].
func BroadcastInnerAxisInt32(x [2][1][3]int32) [2][5][3]int32 {
	return shape.Broadcast[[]int{2, 5, 3}](x)
}
