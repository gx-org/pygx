package gxtftests

// CastFloat32ToFloat64 converts x to float64.
func CastFloat32ToFloat64(x [2][10]float32) [2][10]float64 {
	return [2][10]float64(x)
}

// CastFloat32ToInt32 converts x to int32.
func CastFloat32ToInt32(x [2][10]float32) [2][10]int32 {
	return [2][10]int32(x)
}

// CastFloat32ToInt64 converts x to int64.
func CastFloat32ToInt64(x [17]float32) [17]int64 {
	return [17]int64(x)
}

// CastBoolToFloat32 converts x != 0 to float32 (as in Bernoulli.quantile and Bernoulli.sample).
func CastBoolToFloat32(x [2][10]float32) [2][10]float32 {
	return [2][10]float32(x != 0)
}
